NODE_ENV=development
LOG_LEVEL=log

HTTP_PORT=3001
TCP_HOST=127.0.0.1
TCP_PORT=4001

NASA_SERVICE_TCP_HOST=127.0.0.1
NASA_SERVICE_TCP_PORT=4002

# Required when NODE_ENV=production. Locally the SDK also accepts an `ant auth login` profile.
# Leave it commented out rather than empty: an empty value shadows the profile.
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=high
AI_TIMEOUT_MS=60000

RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=200
RETRY_MAX_DELAY_MS=5000
RETRY_BACKOFF_MULTIPLIER=2
RETRY_JITTER_RATIO=0.3
RETRY_TIMEOUT_MS=5000

IDEMPOTENCY_TTL_MS=86400000
IDEMPOTENCY_SWEEP_INTERVAL_MS=60000
IDEMPOTENCY_MAX_ENTRIES=10000

SHUTDOWN_GRACE_MS=10000
